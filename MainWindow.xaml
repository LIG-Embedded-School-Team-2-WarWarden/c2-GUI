<Window x:Class="AadcCommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AADC-9" Width="1500" Height="850"
        MinWidth="760" MinHeight="480" WindowState="Maximized" Background="#07100F" Foreground="#C3D6CE"
        FontFamily="Consolas" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Window.Resources>
  <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="⬡  A A D C - 9" Foreground="{StaticResource Green}" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="ClockText" Foreground="{StaticResource Muted}" Margin="0,0,8,0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1" Margin="0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Workspace_PreviewMouseWheel" SizeChanged="WorkspaceScrollViewer_SizeChanged"><Grid x:Name="WorkspaceLayout" MinHeight="560"><Grid.LayoutTransform><ScaleTransform x:Name="WorkspaceScaleTransform" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="300" MinWidth="230"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,6,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="*" MinHeight="230"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False"><TextBlock Text="RDR" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/><ComboBox x:Name="RdrSelector" Width="88" Height="18" MinWidth="80" FontSize="11" Padding="3,0" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" DisplayMemberPath="DisplayName" SelectionChanged="RdrSelectionChanged"/></DockPanel>
        <TextBlock Grid.Row="1" x:Name="RdrStatusLine" Text="RDR 자산 프레임 대기" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="230"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Canvas x:Name="RadarCanvas" MinHeight="230" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#07110F" ClipToBounds="True" SizeChanged="RadarCanvasSizeChanged"/>
          <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="5,6" Background="#0A1413"><StackPanel>
            <TextBlock Text="점선: FCS 최대 거리 · 주황색 영역: RDR 음영 지역"
                       FontSize="10" TextWrapping="Wrap" Margin="0,3,0,3"/>
          </StackPanel></Border>
        </Grid>
        <Button x:Name="RdrOperatingToggleButton" Grid.Row="4" Content="라이다 구동" Click="RdrOperatingToggleClick" Margin="4,4" Height="30" IsEnabled="False" Background="#A91528" Foreground="White" BorderBrush="#FF5263"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.95"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button><UniformGrid Grid.Row="5" Columns="2" Rows="3"><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="RDR ID" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrIdText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrEnabledText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="구동" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrOperatingText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="연결" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrConnectedText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="방위각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrAzText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="고각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrElText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border></UniformGrid>
        <Grid Grid.Row="6" Margin="4,8,4,4"><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="30"/></Grid.RowDefinitions><DockPanel><TextBlock Text="라이다 고각 조정" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="RdrElevationInput" Width="52" Height="21" MaxLength="4" Text="0.0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" PreviewTextInput="RdrElevationInputPreviewTextInput" TextChanged="RdrElevationInputTextChanged" IsEnabled="False"/><TextBlock Text="°" VerticalAlignment="Center" Margin="2,0,5,0"/><Button Content="적용" Click="RdrElevationInputApplyClick" Width="42" Height="21" Padding="2,0" FontSize="10" IsEnabled="False" x:Name="RdrElevationApplyButton"/></StackPanel><TextBlock x:Name="RdrElevationSliderValue" Text="0.0°" Foreground="{StaticResource Green}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel><DockPanel Grid.Row="1"><TextBlock Text="0.0°" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10"/><Slider x:Name="RdrElevationSlider" Minimum="0" Maximum="90" TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="RdrElevationSliderValueChanged" IsEnabled="False" Margin="8,0" VerticalAlignment="Center" MinWidth="210"/><TextBlock Text="90.0°" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10"/></DockPanel></Grid>
      </Grid></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}" ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="2" Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="135"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="객체 목록" Foreground="{StaticResource Green}" FontWeight="Bold" Margin="5,0,8,0"/><TextBlock x:Name="TargetCountText" Text="0 / 10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></Grid>
        <DataGrid x:Name="TargetGrid" Grid.Row="1" ItemsSource="{Binding Targets}" SelectionChanged="TargetGridSelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#07100F" BorderBrush="{StaticResource Line}" Foreground="#C3D6CE" RowBackground="#07100F" AlternatingRowBackground="#091411" SelectionMode="Single" IsReadOnly="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="객체 ID" Binding="{Binding DisplayName}" IsReadOnly="True" Width="0.9*" MinWidth="76"/><DataGridTextColumn Header="방위각" Binding="{Binding AzimuthText}" IsReadOnly="True" Width="0.9*" MinWidth="68"/><DataGridTextColumn Header="고각" Binding="{Binding ElevationText}" IsReadOnly="True" Width="0.75*" MinWidth="55"/><DataGridTextColumn Header="거리(m)" Binding="{Binding DistanceText}" IsReadOnly="True" Width="0.9*" MinWidth="68"/>
            <DataGridTextColumn Header="X" Binding="{Binding LidarXText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Y" Binding="{Binding LidarYText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Z" Binding="{Binding LidarZText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="RDR ID" Binding="{Binding RdrId}" IsReadOnly="True" Width="0.8*" MinWidth="58"/><DataGridTextColumn Header="상태" Binding="{Binding StatusText}" IsReadOnly="True" Width="0.9*" MinWidth="110"/>
            <DataGridTemplateColumn Header="FCS" Width="1.15*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.FcsAssets, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedFcsId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="할당" Width="1.1*" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Click="TargetAssignClick" Padding="5,3" IsEnabled="{Binding CanAssign}">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Content" Value="객체 할당"/>
                        <Setter Property="Background" Value="#08251B"/>
                        <Setter Property="Foreground" Value="#00E68A"/>
                        <Setter Property="BorderBrush" Value="#1B5842"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                            <Setter Property="Content" Value="할당 완료"/>
                            <Setter Property="Background" Value="#805000"/>
                            <Setter Property="Foreground" Value="#FFE0A3"/>
                            <Setter Property="BorderBrush" Value="#FFB000"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsAssignmentPending}" Value="True">
                            <Setter Property="Content" Value="연결 시도 중"/>
                            <Setter Property="Background" Value="#805000"/>
                            <Setter Property="Foreground" Value="#FFE0A3"/>
                            <Setter Property="BorderBrush" Value="#FFB000"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="1">
                            <Setter Property="Content" Value="할당 불가"/>
                            <Setter Property="Background" Value="#521722"/>
                            <Setter Property="Foreground" Value="#FFADB8"/>
                            <Setter Property="BorderBrush" Value="#A94355"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Margin="0,6,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
          <Grid>
            <Grid.Resources>
              <Style x:Key="AssignmentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0D3828"/>
                <Setter Property="Foreground" Value="#7AF5BB"/>
                <Setter Property="BorderBrush" Value="#2B9168"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="MinHeight" Value="21"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Surface" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#111D18"/>
                    <Setter Property="Foreground" Value="#748F80"/>
                    <Setter Property="BorderBrush" Value="#30463A"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="Background" Value="#34280E"/>
                    <Setter Property="Foreground" Value="#F4CC67"/>
                    <Setter Property="BorderBrush" Value="#826629"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
              <DataTemplate x:Key="AssignmentProgressTemplate">
                <Grid Margin="8,2,8,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,5">
                    <StackPanel x:Name="AssignmentActions" DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Content="취소" Click="CancelAssignmentClick" IsEnabled="{Binding StageCommandsEnabled}"
                              Style="{StaticResource AssignmentButtonStyle}" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding ProgressTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="AssignmentCurrentState" Text="{Binding StateText, StringFormat='현재: {0}'}" Foreground="#FFB000"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Stages}" IsEnabled="{Binding StageCommandsEnabled}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="5"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border x:Name="StageCard" Height="84" Background="Black" BorderBrush="{StaticResource Line}"
                                  BorderThickness="1" Margin="3,0" Padding="3">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="30"/>
                              </Grid.RowDefinitions>
                              <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Label}"/>
                              <TextBlock x:Name="StageStatus" Grid.Row="1" Text="{Binding Status}" Foreground="#92AFA5"
                                         FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                              <Button x:Name="StageAction" Grid.Row="2" Content="{Binding ActionLabel}" ToolTip="{Binding ActionLabel}" Click="AssignmentStageClick"
                                      Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      Style="{StaticResource AssignmentButtonStyle}" IsEnabled="{Binding CanAdvance}" Padding="1,0">
                                <Button.ContentTemplate>
                                  <DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
                                </Button.ContentTemplate>
                              </Button>
                            </Grid>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding ActionLabel}" Value="{x:Null}">
                              <Setter TargetName="StageAction" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="완료">
                              <Setter TargetName="StageCard" Property="Background" Value="#0A261D"/>
                              <Setter TargetName="StageStatus" Property="Foreground" Value="{StaticResource Green}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                              <Setter TargetName="StageCard" Property="Background" Value="#32250D"/>
                              <Setter TargetName="StageCard" Property="BorderBrush" Value="#FFB000"/>
                              <Setter TargetName="StageStatus" Property="Foreground" Value="#FFB000"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasAssignment}" Value="False">
                    <Setter TargetName="AssignmentActions" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AssignmentCurrentState" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="28"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="객체 할당 정보" Foreground="{StaticResource Green}" Margin="10,5"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Assignments}" ItemTemplate="{StaticResource AssignmentProgressTemplate}"/>
            </ScrollViewer>
            <ContentControl x:Name="AssignmentEmptyState" Grid.Row="1" ContentTemplate="{StaticResource AssignmentProgressTemplate}"
                            HorizontalContentAlignment="Stretch" VerticalAlignment="Top"/>
          </Grid>
        </Border>
        <Border Grid.Row="3" Margin="0,6,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="10,3" VerticalAlignment="Center"><TextBlock Text="이벤트 로그" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><Button Content="로그파일 열기" Click="OpenEventLogClick" Margin="8,0,0,0" Width="82" Height="19" Padding="3,0" FontSize="9"/></StackPanel><ListBox x:Name="EventLogList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#8BB0A1" FontSize="11"/></Grid></Border>
      </Grid>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}" ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8"><TextBlock Text="FCS" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="FcsSelector" Margin="0,5,0,4" DisplayMemberPath="DisplayName" SelectionChanged="FcsSelectionChanged"/><UniformGrid Columns="2" Rows="4" Margin="0,3"><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="FCS ID" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsIdText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsEnabledText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="구동" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsOperatingText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="연결" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsConnectedText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="레이저" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsLaserText" Text="—" Foreground="#FFB000" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="방위각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsAzText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="고각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsElText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border></UniformGrid><Button Content="장비 설정 · 범위 미리보기" Click="EquipmentSettingsClick" Margin="3,5"/><TextBlock x:Name="InstallationPositionsText" Text="실제 설치 위치: ECS 연결 대기 (m)" TextWrapping="Wrap" Margin="3"/><Button x:Name="RdrPositionToggleButton" Content="RDR 영점 보정 (m)" Click="RdrPositionToggleClick" Margin="3,5,3,2" HorizontalAlignment="Stretch"/><Border x:Name="RdrPositionEditor" Height="0" Visibility="Collapsed" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#07110F" Margin="3,0,3,5"><StackPanel Margin="6"><TextBlock Text="RDR 영점 보정 · X / Y / Z (m)" Foreground="{StaticResource Green}" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><TextBox x:Name="RdrXInput" TextChanged="RdrPositionTextChanged" Width="58"/><TextBox x:Name="RdrYInput" TextChanged="RdrPositionTextChanged" Width="58" Margin="4,0"/><TextBox x:Name="RdrZInput" TextChanged="RdrPositionTextChanged" Width="58"/><Button Content="적용" Click="RdrPositionApplyClick" Margin="4,0,0,0"/></StackPanel></StackPanel></Border><Button x:Name="FcsPositionToggleButton" Content="FCS 영점 보정 (m)" Click="FcsPositionToggleClick" Margin="3,5,3,2" HorizontalAlignment="Stretch"/><Border x:Name="FcsPositionEditor" Height="0" Visibility="Collapsed" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#07110F" Margin="3,0,3,5"><StackPanel Margin="6"><TextBlock Text="FCS 영점 보정 · X / Y / Z (m)" Foreground="{StaticResource Green}" Margin="0,0,0,4"/><StackPanel Orientation="Horizontal"><TextBox x:Name="FcsXInput" TextChanged="FcsPositionTextChanged" Width="58"/><TextBox x:Name="FcsYInput" TextChanged="FcsPositionTextChanged" Width="58" Margin="4,0"/><TextBox x:Name="FcsZInput" TextChanged="FcsPositionTextChanged" Width="58"/><Button Content="적용" Click="FcsPositionApplyClick" Margin="4,0,0,0"/></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></Border>
    </Grid></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="● " Foreground="#FFB000"/><TextBlock x:Name="SharedMemoryStatus" Text="공유 메모리 수신기 시작 중" Foreground="#FFB000"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="−" Click="ZoomOutClick" Width="18" Height="17" Padding="0" FontSize="9"/><Button x:Name="ZoomResetButton" Content="100%" Click="ZoomResetClick" Width="38" Height="17" Padding="1,0" Margin="2,0" FontSize="9"/><Button Content="+" Click="ZoomInClick" Width="18" Height="17" Padding="0" FontSize="9"/></StackPanel></DockPanel></Border>
  </Grid>
</Window>
