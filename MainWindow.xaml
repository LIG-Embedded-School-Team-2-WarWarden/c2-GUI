<Window x:Class="AadcCommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AADC-9 | 대공방어 통제 시스템" Width="1500" Height="850"
        MinWidth="760" MinHeight="480" WindowState="Maximized" Background="#07100F" Foreground="#C3D6CE"
        FontFamily="Consolas" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0A1413"/><SolidColorBrush x:Key="Line" Color="#1B3831"/>
    <SolidColorBrush x:Key="Green" Color="#00E68A"/><SolidColorBrush x:Key="Muted" Color="#52796D"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C3D6CE"/><Setter Property="FontFamily" Value="Consolas"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0D1C19"/><Setter Property="Foreground" Value="#6C9887"/><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#1B3831"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#C3D6CE"/><Setter Property="BorderBrush" Value="#193A2E"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#B7F7D8"/><Setter Property="Foreground" Value="#07100F"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#B7F7D8"/><Setter Property="Foreground" Value="#071B33"/><Setter Property="BorderBrush" Value="#1B5842"/><Setter Property="Padding" Value="5,3"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#08251B"/><Setter Property="Foreground" Value="#00E68A"/><Setter Property="BorderBrush" Value="#1B5842"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="FieldCard" TargetType="Border"><Setter Property="BorderBrush" Value="#1B3831"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#0A1413"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="3"/></Style>
  </Window.Resources>
  <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><DockPanel VerticalAlignment="Center">
      <TextBlock Text="⬡  A A D C - 9   대공방어 통제 시스템" Foreground="{StaticResource Green}" FontSize="16" FontWeight="Bold" Width="326"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock x:Name="ClockText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
    </DockPanel></Border>
    <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1" Margin="0,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Workspace_PreviewMouseWheel" SizeChanged="WorkspaceScrollViewer_SizeChanged"><Grid x:Name="WorkspaceLayout" MinHeight="560"><Grid.LayoutTransform><ScaleTransform x:Name="WorkspaceScaleTransform" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform><Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="6"/><ColumnDefinition Width="300" MinWidth="230"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,6,0"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="False"><TextBlock Text="탐지 레이더" Foreground="{StaticResource Green}" FontWeight="Bold" Height="18" VerticalAlignment="Center"/><ComboBox x:Name="RdrSelector" Width="88" Height="18" MinWidth="80" FontSize="11" Padding="3,0" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" DisplayMemberPath="DisplayName" SelectionChanged="RdrSelectionChanged"/></DockPanel>
        <TextBlock Grid.Row="1" x:Name="RdrStatusLine" Text="RDR 자산 프레임 대기" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
        <Canvas x:Name="RadarCanvas" Grid.Row="2" Width="260" Height="300" HorizontalAlignment="Center" Background="#07110F" ClipToBounds="True">
          <Ellipse Width="250" Height="250" Stroke="#1B5842" Canvas.Left="5" Canvas.Top="20"/><Ellipse Width="166" Height="166" Stroke="#16412F" StrokeDashArray="3 4" Canvas.Left="47" Canvas.Top="62"/><Ellipse Width="82" Height="82" Stroke="#16412F" StrokeDashArray="3 4" Canvas.Left="89" Canvas.Top="104"/>
          <Line X1="130" Y1="20" X2="130" Y2="270" Stroke="#184331"/><Line X1="5" Y1="145" X2="255" Y2="145" Stroke="#184331"/><Line X1="41" Y1="56" X2="219" Y2="234" Stroke="#123126"/><Line X1="219" Y1="56" X2="41" Y2="234" Stroke="#123126"/>
          <TextBlock Text="−135°" Foreground="#52796D" FontSize="9" Canvas.Left="0" Canvas.Top="272"/><TextBlock Text="0°" Foreground="#52796D" FontSize="9" Canvas.Left="124" Canvas.Top="4"/><TextBlock Text="+135° / 270°" Foreground="#52796D" FontSize="9" Canvas.Left="194" Canvas.Top="272"/>
          <Line x:Name="RadarSweep" X1="130" Y1="145" X2="130" Y2="22" Stroke="#00E68A" StrokeThickness="2"/>
          <Ellipse Width="8" Height="8" Fill="#00E68A" Canvas.Left="126" Canvas.Top="141"/>
        </Canvas>
        <UniformGrid Grid.Row="4" Columns="2" Rows="3"><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="RDR ID" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrIdText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrEnabledText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="구동" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrOperatingText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="연결" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrConnectedText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="방위각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrAzText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="고각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RdrElText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border></UniformGrid>
      </Grid></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}" ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="2" Margin="0,0,0,0"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="150"/><RowDefinition Height="135"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="표적 목록" Foreground="{StaticResource Green}" FontWeight="Bold" Width="65" Height="12" Margin="5,0,0,0"/><TextBlock x:Name="TargetCountText" Text="0 / 10" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel>
        <DataGrid x:Name="TargetGrid" Grid.Row="1" ItemsSource="{Binding Targets}" SelectionChanged="TargetGridSelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#07100F" BorderBrush="{StaticResource Line}" Foreground="#C3D6CE" RowBackground="#07100F" AlternatingRowBackground="#091411" SelectionMode="Single" IsReadOnly="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="표적 ID" Binding="{Binding DisplayName}" IsReadOnly="True" Width="1.2*" MinWidth="105"/><DataGridTextColumn Header="방위각" Binding="{Binding AzimuthText}" IsReadOnly="True" Width="0.9*" MinWidth="68"/><DataGridTextColumn Header="고각" Binding="{Binding ElevationText}" IsReadOnly="True" Width="0.75*" MinWidth="55"/><DataGridTextColumn Header="거리(m)" Binding="{Binding DistanceText}" IsReadOnly="True" Width="0.9*" MinWidth="68"/>
            <DataGridTextColumn Header="X" Binding="{Binding LidarXText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Y" Binding="{Binding LidarYText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Z" Binding="{Binding LidarZText}" IsReadOnly="True" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="RDR ID" Binding="{Binding RdrId}" IsReadOnly="True" Width="0.8*" MinWidth="58"/><DataGridTextColumn Header="상태" Binding="{Binding StatusText}" IsReadOnly="True" Width="0.9*" MinWidth="65"/>
            <DataGridTemplateColumn Header="타격자산" Width="1.15*" MinWidth="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.FcsAssets, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedFcsId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="할당" Width="1.1*" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="TargetAssignClick" Padding="5,3"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="표적 할당"/><Setter Property="Background" Value="#08251B"/><Setter Property="Foreground" Value="#00E68A"/><Style.Triggers><DataTrigger Binding="{Binding IsAssigned}" Value="True"><Setter Property="Content" Value="할당 완료"/><Setter Property="Background" Value="#805000"/><Setter Property="Foreground" Value="#FFE0A3"/><Setter Property="BorderBrush" Value="#FFB000"/></DataTrigger><DataTrigger Binding="{Binding IsAssignmentPending}" Value="True"><Setter Property="Content" Value="연결 시도 중"/><Setter Property="Background" Value="#805000"/><Setter Property="Foreground" Value="#FFE0A3"/><Setter Property="BorderBrush" Value="#FFB000"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Margin="0,6,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="표적 할당 정보" Foreground="{StaticResource Green}" Margin="10,5"/><DataGrid x:Name="AssignmentGrid" Grid.Row="1" ItemsSource="{Binding Assignments}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#07100F" BorderBrush="{StaticResource Line}" Foreground="#C3D6CE" RowBackground="#07100F" AlternatingRowBackground="#091411" IsReadOnly="True" FontSize="10"><DataGrid.Columns><DataGridTextColumn Header="표적 ID" Binding="{Binding TargetName}" Width="1.1*" MinWidth="85"/><DataGridTextColumn Header="타격자산" Binding="{Binding FcsName}" Width="0.9*" MinWidth="70"/><DataGridTextColumn Header="방위각" Binding="{Binding AzimuthText}" Width="0.8*" MinWidth="62"/><DataGridTextColumn Header="고각" Binding="{Binding ElevationText}" Width="0.7*" MinWidth="52"/><DataGridTextColumn Header="거리(m)" Binding="{Binding DistanceText}" Width="0.9*" MinWidth="70"/><DataGridTextColumn Header="X" Binding="{Binding LidarXText}" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Y" Binding="{Binding LidarYText}" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="Z" Binding="{Binding LidarZText}" Width="0.7*" MinWidth="48"/><DataGridTextColumn Header="RDR ID" Binding="{Binding RdrIdText}" Width="0.8*" MinWidth="58"/><DataGridTextColumn Header="표적 상태" Binding="{Binding TargetStatusText}" Width="1.0*" MinWidth="78"/><DataGridTextColumn Header="할당 상태" Binding="{Binding StateText}" Width="1.5*" MinWidth="110"/><DataGridTemplateColumn Header="발사" Width="0.75*" MinWidth="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Click="FireAssignmentClick" Padding="4,2"><Button.Style><Style TargetType="Button"><Setter Property="Content" Value="대기"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#805000"/><Setter Property="Foreground" Value="#FFE0A3"/><Setter Property="BorderBrush" Value="#FFB000"/><Style.Triggers><DataTrigger Binding="{Binding CanFire}" Value="True"><Setter Property="Content" Value="발사"/><Setter Property="IsHitTestVisible" Value="True"/><Setter Property="Focusable" Value="True"/><Setter Property="Background" Value="#681326"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF3152"/></DataTrigger><DataTrigger Binding="{Binding StateText}" Value="발사 완료"><Setter Property="Content" Value="완료"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#805000"/><Setter Property="Foreground" Value="#FFE0A3"/><Setter Property="BorderBrush" Value="#FFB000"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="취소" Width="0.75*" MinWidth="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="취소" Click="CancelAssignmentClick" Padding="4,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock x:Name="AssignmentEmptyText" Grid.Row="1" Text="할당된 표적이 없습니다" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
        <Border Grid.Row="3" Margin="0,6,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="10,3" VerticalAlignment="Center"><TextBlock Text="이벤트 로그" Foreground="{StaticResource Green}" VerticalAlignment="Center"/><Button Content="로그파일 열기" Click="OpenEventLogClick" Margin="8,0,0,0" Width="82" Height="19" Padding="3,0" FontSize="9"/></StackPanel><ListBox x:Name="EventLogList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#8BB0A1" FontSize="11"/></Grid></Border>
      </Grid>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource Line}" ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"><StackPanel Margin="14"><TextBlock Text="타격 자산" Foreground="{StaticResource Green}" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="FcsSelector" Margin="0,12,0,10" DisplayMemberPath="DisplayName" SelectionChanged="FcsSelectionChanged"/><UniformGrid Columns="2" Rows="4" Margin="0,8"><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="FCS ID" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsIdText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="사용 가능" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsEnabledText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="구동" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsOperatingText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="연결" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsConnectedText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="레이저" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsLaserText" Text="—" Foreground="#FFB000" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="방위각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsAzText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border><Border Style="{StaticResource FieldCard}"><StackPanel><TextBlock Text="고각" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FcsElText" Text="—" Foreground="{StaticResource Green}" FontSize="15"/></StackPanel></Border></UniformGrid><TextBlock Text="발사 명령은 공유 메모리 명령 송신기 연동 후 활성화됩니다." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,12"/></StackPanel></Border>
    </Grid></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="● " Foreground="#FFB000"/><TextBlock x:Name="SharedMemoryStatus" Text="공유 메모리 수신기 시작 중" Foreground="#FFB000"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="−" Click="ZoomOutClick" Width="18" Height="17" Padding="0" FontSize="9"/><Button x:Name="ZoomResetButton" Content="100%" Click="ZoomResetClick" Width="38" Height="17" Padding="1,0" Margin="2,0" FontSize="9"/><Button Content="+" Click="ZoomInClick" Width="18" Height="17" Padding="0" FontSize="9"/></StackPanel></DockPanel></Border>
  </Grid>
</Window>
